# Server Configuration
PORT=5000

# Database Configuration
MONGO_URL=mongodb://localhost:27017/medivault

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration
# Brevo Transactional Email API
# Sign up at https://www.brevo.com/ and get API key from Account Settings > API Keys
BREVO_API_KEY=your-brevo-api-key

# Sender email address
EMAIL_FROM=noreply@medivault.com

# Optional: Log invite links for debugging
LOG_INVITE_LINK=false
