# Server Configuration
PORT=5000

# Database Configuration
MONGO_URL=mongodb://localhost:27017/medivault

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration
# Choose your email provider: resend, brevo, gmail, or custom
EMAIL_PROVIDER=resend

# Option 1: Resend (Recommended for cloud platforms like Render)
# Sign up at https://resend.com/signup and get API key from Settings > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Option 2: Brevo (Recommended production SMTP - free tier available)
# Sign up at https://www.brevo.com/ and get API keys from SMTP & API settings
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_KEY=your-brevo-smtp-key

# Option 3: Gmail (Not recommended for cloud platforms - may timeout)
# IMPORTANT: For Gmail, you must use an App-Specific Password, not your regular password
# Get one here: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Option 4: Custom SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional: Custom from address (defaults to noreply@medivault.com)
EMAIL_FROM=noreply@medivault.com

# Optional: Log invite links for debugging
LOG_INVITE_LINK=false
